{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "building_id": {
      "type": "string",
      "description": "Building this event is for"
    },
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "event_date": {
      "type": "string",
      "format": "date-time",
      "description": "Event date and time"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "maintenance",
        "inspection",
        "meeting",
        "move_in",
        "move_out",
        "emergency",
        "general"
      ],
      "default": "general",
      "description": "Type of event"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "scheduled",
      "description": "Event status"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether reminder email was sent"
    }
  },
  "required": [
    "title",
    "event_date",
    "event_type"
  ]
}