{
  "name": "BuildingBylaw",
  "type": "object",
  "properties": {
    "building_id": {
      "type": "string",
      "description": "Reference to building"
    },
    "document_id": {
      "type": "string",
      "description": "Reference to source document"
    },
    "bylaw_type": {
      "type": "string",
      "enum": [
        "pets",
        "parking",
        "noise",
        "renovations",
        "rental",
        "common_property",
        "balcony_outdoor",
        "waste_disposal",
        "storage",
        "conduct",
        "amenity_usage",
        "other"
      ],
      "description": "Category of bylaw"
    },
    "title": {
      "type": "string",
      "description": "Bylaw title or summary"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the bylaw"
    },
    "restrictions": {
      "type": "string",
      "description": "Specific restrictions or rules"
    },
    "penalties": {
      "type": "string",
      "description": "Penalties for non-compliance"
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "When this bylaw became effective"
    },
    "amended_date": {
      "type": "string",
      "format": "date",
      "description": "Last amendment date"
    },
    "amendment_notes": {
      "type": "string",
      "description": "Notes about amendments"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "archived"
      ],
      "default": "active",
      "description": "Current status of this bylaw"
    }
  },
  "required": [
    "building_id",
    "bylaw_type",
    "title"
  ]
}