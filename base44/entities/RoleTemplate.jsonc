{
  "name": "RoleTemplate",
  "type": "object",
  "properties": {
    "role_name": {
      "type": "string",
      "enum": [
        "admin",
        "owner",
        "resident",
        "staff",
        "external_management",
        "contractor"
      ],
      "description": "Role name"
    },
    "display_name": {
      "type": "string",
      "description": "Display name for the role"
    },
    "description": {
      "type": "string",
      "description": "Description of the role"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a default system role"
    },
    "permissions": {
      "type": "object",
      "properties": {
        "documents": {
          "type": "object",
          "properties": {
            "view": {
              "type": "boolean",
              "default": true
            },
            "create": {
              "type": "boolean",
              "default": false
            },
            "edit": {
              "type": "boolean",
              "default": false
            },
            "delete": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "buildings": {
          "type": "object",
          "properties": {
            "view": {
              "type": "boolean",
              "default": false
            },
            "create": {
              "type": "boolean",
              "default": false
            },
            "edit": {
              "type": "boolean",
              "default": false
            },
            "delete": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "residents": {
          "type": "object",
          "properties": {
            "view": {
              "type": "boolean",
              "default": false
            },
            "create": {
              "type": "boolean",
              "default": false
            },
            "edit": {
              "type": "boolean",
              "default": false
            },
            "delete": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "work_orders": {
          "type": "object",
          "properties": {
            "view": {
              "type": "boolean",
              "default": true
            },
            "create": {
              "type": "boolean",
              "default": true
            },
            "edit": {
              "type": "boolean",
              "default": false
            },
            "delete": {
              "type": "boolean",
              "default": false
            },
            "assign": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "announcements": {
          "type": "object",
          "properties": {
            "view": {
              "type": "boolean",
              "default": true
            },
            "create": {
              "type": "boolean",
              "default": false
            },
            "edit": {
              "type": "boolean",
              "default": false
            },
            "delete": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "amenities": {
          "type": "object",
          "properties": {
            "view": {
              "type": "boolean",
              "default": true
            },
            "book": {
              "type": "boolean",
              "default": true
            },
            "manage": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "contractors": {
          "type": "object",
          "properties": {
            "view": {
              "type": "boolean",
              "default": false
            },
            "create": {
              "type": "boolean",
              "default": false
            },
            "edit": {
              "type": "boolean",
              "default": false
            },
            "delete": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "reports": {
          "type": "object",
          "properties": {
            "view": {
              "type": "boolean",
              "default": false
            },
            "generate": {
              "type": "boolean",
              "default": false
            }
          }
        }
      },
      "description": "Default permissions for this role"
    }
  },
  "required": [
    "role_name",
    "display_name",
    "permissions"
  ]
}