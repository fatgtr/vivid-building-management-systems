{
  "name": "PetRegistry",
  "type": "object",
  "properties": {
    "building_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "resident_id": {
      "type": "string"
    },
    "pet_name": {
      "type": "string"
    },
    "pet_type": {
      "type": "string",
      "enum": [
        "dog",
        "cat",
        "bird",
        "fish",
        "reptile",
        "small_mammal",
        "other"
      ],
      "default": "dog"
    },
    "breed": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "age": {
      "type": "number"
    },
    "weight_kg": {
      "type": "number"
    },
    "microchip_number": {
      "type": "string"
    },
    "registration_number": {
      "type": "string",
      "description": "Council registration"
    },
    "vaccination_expiry": {
      "type": "string",
      "format": "date"
    },
    "vet_name": {
      "type": "string"
    },
    "vet_phone": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "approved": {
      "type": "boolean",
      "default": false,
      "description": "Approved by building management"
    },
    "approval_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "moved_out",
        "deceased"
      ],
      "default": "active"
    }
  },
  "required": [
    "building_id",
    "unit_id",
    "pet_name",
    "pet_type"
  ]
}