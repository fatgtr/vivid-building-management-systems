{
  "name": "ImportantNumber",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "phone_number": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "emergency",
        "management",
        "committee",
        "contractor",
        "other"
      ],
      "default": "other"
    },
    "building_id": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text description (up to 1000 characters)"
    }
  },
  "required": [
    "name",
    "phone_number"
  ]
}