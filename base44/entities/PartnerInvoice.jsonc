{
  "name": "PartnerInvoice",
  "type": "object",
  "properties": {
    "partner_id": {
      "type": "string",
      "description": "Partner this invoice is for"
    },
    "invoice_number": {
      "type": "string",
      "description": "Unique invoice number"
    },
    "billing_period_start": {
      "type": "string",
      "format": "date",
      "description": "Start of billing period"
    },
    "billing_period_end": {
      "type": "string",
      "format": "date",
      "description": "End of billing period"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "building_id": {
            "type": "string"
          },
          "building_name": {
            "type": "string"
          },
          "strata_plan": {
            "type": "string"
          },
          "lot_count": {
            "type": "number"
          },
          "rate_per_lot": {
            "type": "number"
          },
          "months": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      },
      "description": "Individual line items for each building"
    },
    "subtotal": {
      "type": "number",
      "description": "Total before tax"
    },
    "tax_rate": {
      "type": "number",
      "default": 0.1,
      "description": "Tax rate (e.g., 0.10 for 10% GST)"
    },
    "tax_amount": {
      "type": "number",
      "description": "Tax amount"
    },
    "total_amount": {
      "type": "number",
      "description": "Total amount due"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue",
        "cancelled"
      ],
      "default": "draft",
      "description": "Invoice status"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Payment due date"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "Date payment was received"
    },
    "payment_method": {
      "type": "string",
      "description": "How payment was received"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "partner_id",
    "billing_period_start",
    "billing_period_end"
  ]
}