{
  "name": "Policy",
  "type": "object",
  "properties": {
    "building_id": {
      "type": "string",
      "description": "Reference to building"
    },
    "source_document_id": {
      "type": "string",
      "description": "Document this policy was extracted from"
    },
    "policy_type": {
      "type": "string",
      "enum": [
        "move_in_move_out",
        "pet_policy",
        "whs_safety",
        "noise_disturbance",
        "parking",
        "common_area_usage",
        "renovation_alterations",
        "waste_management",
        "smoking",
        "short_term_rental",
        "guest_policy",
        "amenity_usage",
        "general"
      ],
      "description": "Type of policy"
    },
    "title": {
      "type": "string",
      "description": "Policy title"
    },
    "content": {
      "type": "string",
      "description": "Full policy text and procedures"
    },
    "key_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Summary of key requirements"
    },
    "applies_to": {
      "type": "string",
      "enum": [
        "all_residents",
        "owners_only",
        "tenants_only",
        "contractors",
        "visitors"
      ],
      "default": "all_residents"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "archived"
      ],
      "default": "active"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "ai_generated": {
      "type": "boolean",
      "default": false,
      "description": "Whether this was AI-generated from a document"
    },
    "review_required": {
      "type": "boolean",
      "default": true,
      "description": "Whether this needs human review before activation"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Current version number"
    },
    "parent_policy_id": {
      "type": "string",
      "description": "ID of the original policy if this is a version"
    },
    "version_notes": {
      "type": "string",
      "description": "Notes about this version's changes"
    },
    "is_current_version": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is the currently active version"
    },
    "superseded_by": {
      "type": "string",
      "description": "ID of the policy version that replaced this one"
    },
    "superseded_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this version was superseded"
    }
  },
  "required": [
    "building_id",
    "policy_type",
    "title",
    "content"
  ]
}