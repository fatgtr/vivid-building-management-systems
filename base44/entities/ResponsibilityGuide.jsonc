{
  "name": "ResponsibilityGuide",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "description": "Category type (e.g., Balcony, Bathroom, Electrical)"
    },
    "item": {
      "type": "string",
      "description": "Specific item within the category"
    },
    "responsible": {
      "type": "string",
      "enum": [
        "Owner",
        "Owners Corporation",
        "Owner/Owners Corporation"
      ],
      "description": "Who is responsible for maintenance"
    },
    "additional_info": {
      "type": "string",
      "description": "Additional information or appendix reference"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text description (up to 1000 characters)"
    }
  },
  "required": [
    "type",
    "item",
    "responsible"
  ]
}