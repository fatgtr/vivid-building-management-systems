{
  "name": "Unit",
  "type": "object",
  "properties": {
    "building_id": {
      "type": "string",
      "description": "Reference to building"
    },
    "unit_number": {
      "type": "string"
    },
    "lot_number": {
      "type": "string",
      "description": "Strata lot number"
    },
    "unit_entitlement": {
      "type": "number",
      "description": "Unit entitlement value"
    },
    "floor": {
      "type": "number"
    },
    "bedrooms": {
      "type": "number"
    },
    "bathrooms": {
      "type": "number"
    },
    "square_feet": {
      "type": "number"
    },
    "has_balcony": {
      "type": "boolean",
      "description": "Whether unit has a balcony",
      "default": false
    },
    "balcony_area": {
      "type": "number",
      "description": "Balcony area in square feet"
    },
    "unit_type": {
      "type": "string",
      "enum": [
        "studio",
        "apartment",
        "penthouse",
        "townhouse",
        "commercial"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "occupied",
        "vacant",
        "maintenance"
      ],
      "default": "vacant"
    },
    "monthly_rent": {
      "type": "number"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "owner_phone": {
      "type": "string"
    },
    "owner_address": {
      "type": "string",
      "description": "Owner's address for service of notices"
    }
  },
  "required": [
    "building_id",
    "unit_number"
  ]
}