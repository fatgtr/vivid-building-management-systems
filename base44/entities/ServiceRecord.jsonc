{
  "name": "ServiceRecord",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string",
      "description": "Reference to Asset"
    },
    "building_id": {
      "type": "string",
      "description": "Reference to Building"
    },
    "maintenance_schedule_id": {
      "type": "string",
      "description": "Reference to MaintenanceSchedule if scheduled service"
    },
    "work_order_id": {
      "type": "string",
      "description": "Reference to WorkOrder if reactive service"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "scheduled_maintenance",
        "preventative_maintenance",
        "corrective_maintenance",
        "emergency_repair",
        "inspection",
        "testing",
        "calibration",
        "replacement",
        "upgrade",
        "other"
      ],
      "description": "Type of service performed"
    },
    "service_date": {
      "type": "string",
      "format": "date",
      "description": "Date service was performed"
    },
    "next_service_date": {
      "type": "string",
      "format": "date",
      "description": "Next scheduled service date"
    },
    "contractor_id": {
      "type": "string",
      "description": "Reference to Contractor"
    },
    "contractor_name": {
      "type": "string",
      "description": "Contractor company name"
    },
    "technician_name": {
      "type": "string",
      "description": "Technician who performed service"
    },
    "description": {
      "type": "string",
      "description": "Description of work performed"
    },
    "parts_replaced": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_name": {
            "type": "string"
          },
          "part_number": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "cost": {
            "type": "number"
          }
        }
      },
      "description": "Parts replaced during service"
    },
    "labour_hours": {
      "type": "number",
      "description": "Hours of labour"
    },
    "labour_cost": {
      "type": "number",
      "description": "Cost of labour"
    },
    "parts_cost": {
      "type": "number",
      "description": "Cost of parts"
    },
    "total_cost": {
      "type": "number",
      "description": "Total service cost"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "incomplete",
        "requires_followup",
        "failed"
      ],
      "default": "completed",
      "description": "Service completion status"
    },
    "findings": {
      "type": "string",
      "description": "Findings during service"
    },
    "issues_found": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Issues discovered"
    },
    "recommendations": {
      "type": "string",
      "description": "Recommendations for future maintenance"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Service photos"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Service reports and certificates"
    },
    "invoice_url": {
      "type": "string",
      "description": "Invoice document URL"
    },
    "invoice_number": {
      "type": "string",
      "description": "Invoice reference number"
    },
    "warranty_expiry": {
      "type": "string",
      "format": "date",
      "description": "Warranty expiry for work performed"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "asset_id",
    "building_id",
    "service_type",
    "service_date"
  ]
}